],"C:\\Users\\Rahul kumar jha\\Downloads\\full ecom\\CodeEternity_venture\\frontend\\src\\Components\\DescriptionBox\\DescriptionBox.jsx",[],[],"C:\\Users\\Rahul kumar jha\\Downloads\\full ecom\\CodeEternity_venture\\frontend\\src\\Components\\RelatedProducts\\RelatedProducts.jsx",["110","111"],[],"import React, { useEffect, useState } from 'react'\r\nimport './RelatedProducts.css'\r\nimport Item from '../Item/Item'\r\nimport { backend_url } from '../../App';\r\n\r\nconst RelatedProducts = ({category,id}) => {\r\n\r\n  const [related,setRelated] = useState([]);\r\n\r\n  useEffect(()=>{\r\n    fetch(`${backend_url}/relatedproducts`,{\r\n      method: 'POST',\r\n      headers: {\r\n        Accept: 'application/json',\r\n        'Content-Type': 'application/json',\r\n      },\r\n      body: JSON.stringify({category:category}),\r\n      })\r\n    .then((res)=>res.json()).then((data)=>setRelated(data))\r\n  },[])\r\n\r\n  return (\r\n    <div className='relatedproducts'>\r\n      <h1>Related Products</h1>\r\n      <hr />\r\n      <div className=\"relatedproducts-item\">\r\n        {related.map((item,index)=>{\r\n          if (id !== item.id) {\r\n            return <Item key={index} id={item.id} name={item.name} image={item.image}  new_price={item.new_price} old_price={item.old_price}/>\r\n          }\r\n        })}\r\n      </div>\r\n    </div>\r\n  )\r\n}\r\n\r\nexport default RelatedProducts\r\n","C:\\Users\\Rahul kumar jha\\Downloads\\full ecom\\CodeEternity_venture\\frontend\\src\\Components\\ProductDisplay\\ProductDisplay.jsx",[],[],"C:\\Users\\Rahul kumar jha\\Downloads\\full ecom\\CodeEternity_venture\\frontend\\src\\Components\\Breadcrums\\Breadcrums.jsx",[],[],{"ruleId":"112","replacedBy":"113"},{"ruleId":"114","severity":1,"message":"115","line":20,"column":5,"nodeType":"116","endLine":20,"endColumn":7,"suggestions":"117"},{"ruleId":"118","severity":1,"message":"119","line":27,"column":34,"nodeType":"120","messageId":"121","endLine":27,"endColumn":36},"no-new-